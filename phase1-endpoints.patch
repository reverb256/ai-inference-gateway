+    @app.post("/v1/search")
+    async def unified_search(request: Request):
+        """
+        Unified search endpoint with automatic mode selection.
+
+        Single sovereign search endpoint that auto-classifies query → routes to best pipeline → returns structured result.
+
+        Body: {
+            "query": str,
+            "mode": "auto" | "web" | "local" | "hybrid",  # default: auto
+            "summarize": bool,  # default: true
+            "collection": str,  # default: "brain-wiki"
+            "max_results": int,  # default: 10
+        }
+
+        Response: {
+            "answer": str,       # summarized answer
+            "sources": [...],    # all sources with scores
+            "intent": str,       # detected intent
+            "mode_used": str,    # actual mode used
+            "novel": bool,       # new-to-brain info?
+            "confidence": str,   # high/medium/low
+        }
+        """
+        body = await request.json()
+        query = body.get("query", "")
+        mode = body.get("mode", "auto")
+        summarize = body.get("summarize", True)
+        collection = body.get("collection", "brain-wiki")
+        max_results = body.get("max_results", 10)
+
+        if not query:
+            raise HTTPException(status_code=400, detail="Missing required parameter: query")
+
+        state: GatewayState = app.state.gateway
+
+        # Auto mode: classify query intent
+        if mode == "auto":
+            if AGENT_SEARCH_AVAILABLE:
+                decision = state.router.classify(query)
+                intent_name = decision.intent.name if hasattr(decision, 'intent') else "FACTUAL"
+                mode_map = {
+                    "REALTIME": "web",
+                    "CODE": "local",
+                    "FACTUAL": "local",
+                    "PROCEDURAL": "local",
+                    "COMPARATIVE": "hybrid",
+                    "CONTEXTUAL": "hybrid"
+                }
+                mode = mode_map.get(intent_name, "local")
+
+        # Route to appropriate search pipeline
+        if mode == "web":
+            # SearXNG web search
+            return await _searxng_search_impl(query, max_results, state)
+        elif mode == "local":
+            # Qdrant vector search
+            return await _qdrant_search_impl(query, collection, max_results, state)
+        elif mode == "hybrid":
+            # Combine both (RRF fusion)
+            return await _hybrid_search_impl(query, collection, max_results, state)
+        else:
+            raise HTTPException(status_code=400, detail=f"Invalid mode: {mode}")
+
+    async def _searxng_search_impl(query: str, max_results: int, state: GatewayState):
+        """Implement SearXNG web search."""
+        if not state.searxng:
+            raise HTTPException(status_code=501, detail="SearXNG service not available")
+
+        try:
+            results = await state.searxng.search(query, max_results=max_results)
+            return {
+                "answer": results.get("summary", ""),
+                "sources": results.get("results", []),
+                "intent": "web",
+                "mode_used": "web",
+                "novel": True,
+                "confidence": "high"
+            }
+        except Exception as e:
+            logger.error(f"SearXNG search error: {e}")
+            raise HTTPException(status_code=503, detail=f"SearXNG search failed: {str(e)}")
+
+    async def _qdrant_search_impl(query: str, collection: str, max_results: int, state: GatewayState):
+        """Implement Qdrant vector search."""
+        if not state.rag_search:
+            raise HTTPException(status_code=501, detail="RAG/Qdrant service not enabled")
+
+        try:
+            # Generate embedding for query
+            if not state.embeddings:
+                raise HTTPException(status_code=501, detail="Embeddings service not available")
+
+            query_embedding = await state.embeddings.embed(query)
+
+            # Search Qdrant
+            from qdrant_client import models as q_models
+            from qdrant_client.http import exceptions as q_exceptions
+
+            search_result = await state.qdrant.search(
+                collection_name=collection,
+                query_vector=query_embedding,
+                limit=max_results
+            )
+
+            sources = [
+                {
+                    "id": hit.id,
+                    "score": hit.score,
+                    "payload": hit.payload.get("metadata", {})
+                }
+                for hit in search_result
+            ]
+
+            return {
+                "answer": f"Found {len(sources)} results in {collection}",
+                "sources": sources,
+                "intent": "local",
+                "mode_used": "local",
+                "novel": False,
+                "confidence": "high"
+            }
+        except Exception as e:
+            logger.error(f"Qdrant search error: {e}")
+            raise HTTPException(status_code=503, detail=f"Qdrant search failed: {str(e)}")
+
+    async def _hybrid_search_impl(query: str, collection: str, max_results: int, state: GatewayState):
+        """Implement hybrid search with RRF fusion."""
+        if not state.rag_search or not state.searxng:
+            raise HTTPException(status_code=501, detail="Both RAG and SearXNG services required for hybrid mode")
+
+        # Run both searches in parallel
+        import asyncio
+        qdrant_task = _qdrant_search_impl(query, collection, max_results, state)
+        searxng_task = _searxng_search_impl(query, max_results, state)
+
+        try:
+            qdrant_result, searxng_result = await asyncio.gather(
+                qdrant_task,
+                searxng_task,
+                return_exceptions=True
+            )
+
+            if isinstance(qdrant_result, Exception):
+                qdrant_result = {"sources": [], "error": str(qdrant_result)}
+            if isinstance(searxng_result, Exception):
+                searxng_result = {"sources": [], "error": str(searxng_result)}
+
+            # RRF fusion (Reciprocal Rank Fusion)
+            rrf_k = 60  # From config
+            combined = _rrf_fusion(
+                qdrant_result.get("sources", []),
+                searxng_result.get("sources", []),
+                rrf_k
+            )
+
+            return {
+                "answer": f"Hybrid search found {len(combined)} results",
+                "sources": combined,
+                "intent": "hybrid",
+                "mode_used": "hybrid",
+                "novel": True,
+                "confidence": "medium"
+            }
+        except Exception as e:
+            logger.error(f"Hybrid search error: {e}")
+            raise HTTPException(status_code=503, detail=f"Hybrid search failed: {str(e)}")
+
+    def _rrf_fusion(qdrant_results, searxng_results, k=60):
+        """Reciprocal Rank Fusion implementation."""
+        scores = {}
+
+        # Score Qdrant results (1-based rank)
+        for i, result in enumerate(qdrant_results, 1):
+            scores[result.get("id", f"qdrant_{i}")] = 1 / (k + i)
+
+        # Score SearXNG results (1-based rank)
+        for i, result in enumerate(searxng_results, 1):
+            scores[result.get("id", f"searxng_{i}")] = 1 / (k + i)
+
+        # Combine and sort
+        ranked = sorted(scores.items(), key=lambda x: x[1], reverse=True)
+
+        return [
+            {"id": item[0], "score": item[1], "source": "qdrant" if "qdrant_" in item[0] else "searxng"}
+            for item in ranked
+        ]
