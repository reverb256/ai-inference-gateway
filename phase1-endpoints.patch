+    @app.post("/v1/knowledge/commit")
+    async def knowledge_commit(request: Request):
+        """
+        Commit knowledge to the brain (Qdrant).
+
+        Body: {
+            "content": str,
+            "source": str,  # "hermes" | "omp" | "search" | "manual"
+            "metadata": {...},
+            "collection": str,  # default: "brain-wiki"
+        }
+        """
+        body = await request.json()
+        content = body.get("content", "")
+        source = body.get("source", "manual")
+        metadata = body.get("metadata", {})
+        collection = body.get("collection", "brain-wiki")
+
+        if not content:
+            raise HTTPException(status_code=400, detail="Missing required parameter: content")
+
+        state: GatewayState = app.state.gateway

+        # Check required services
+        if not state.embeddings:
+            raise HTTPException(status_code=501, detail="Embeddings service not available")
+        if not state.qdrant:
+            raise HTTPException(status_code=501, detail="Qdrant service not available")
+
+        try:
+            # Chunk content
+            from ai_inference_gateway.rag.chunker import TextChunker
+            chunker = TextChunker(chunk_size=1000, overlap=200)
+            chunks = chunker.chunk_text(content)
+
+            # Generate embeddings
+            embeddings = await state.embeddings.embed_batch(chunks)
+
+            # Prepare Qdrant upsert
+            from qdrant_client import models as q_models
+            from qdrant_client.http import AsyncClient as QdrantClient
+
+            points = [
+                q_models.PointStruct(
+                    id=f"{collection}_{source}_{hash(content)}_{i}",
+                    vector=embedding,
+                    payload={
+                        "text": chunk,
+                        "metadata": {
+                            **metadata,
+                            "source": source,
+                            "timestamp": datetime.now().isoformat(),
+                            "chunk_index": i
+                        }
+                    }
+                )
+                for i, (chunk, embedding) in enumerate(zip(chunks, embeddings))
+            ]
+
+            # Upsert to Qdrant
+            await state.qdrant.upsert(
+                collection_name=collection,
                points=points
+            )
+
+            return {
+                "status": "success",
+                "chunks_uploaded": len(chunks),
+                "collection": collection,
+                "source": source
+            }
+        except Exception as e:
+            logger.error(f"Knowledge commit error: {e}")
+            raise HTTPException(status_code=503, detail=f"Knowledge commit failed: {str(e)}")
