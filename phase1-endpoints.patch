+        top_k = body.get("top_k", 10)
+
+        if not query:
+            raise HTTPException(status_code=400, detail="Missing required parameter: query")
+
+        state: GatewayState = app.state.gateway

+        if not state.embeddings or not state.qdrant:
+            raise HTTPException(status_code=501, detail="Knowledge services not available")
+
+        try:
+            # Generate embedding for query
+            query_embedding = await state.embeddings.embed(query)
+
+            # Search Qdrant
+            search_result = await state.qdrant.search(
+                collection_name=collection,
+                query_vector=query_embedding,
+                limit=top_k
+            )
+
+            sources = [
+                {
+                    "id": hit.id,
+                    "score": hit.score,
+                    "text": hit.payload.get("text", ""),
+                    "metadata": hit.payload.get("metadata", {})
+                }
+                for hit in search_result
+            ]
+
+            return {
+                "query": query,
+                "collection": collection,
+ "results": sources,
+                "total": len(sources)
+            }
+        except Exception as e:
+            logger.error(f"Knowledge query error: {e}")
